<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Boys 13U — Scores &amp; Standings</title>
<style>
:root{
  --bg:#f6f7f9; --card:#fff; --ink:#16181d; --muted:#6b7280;
  --line:#e3e6ea; --accent:#1a6b3c; --chip:#eef1f4;
}
@media (prefers-color-scheme:dark){
  :root{ --bg:#111317; --card:#1a1d23; --ink:#e8eaed; --muted:#9aa1ab;
         --line:#2a2f37; --accent:#4ade80; --chip:#242830; }
}
*{box-sizing:border-box}
body{margin:0;padding:16px 12px 48px;background:var(--bg);color:var(--ink);
  font:16px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  max-width:760px;margin-inline:auto}
h1{font-size:1.3rem;margin:0 0 2px}
h2{font-size:1rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);
  margin:28px 0 10px}
.sub{color:var(--muted);font-size:.82rem;margin:0 0 4px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;
  padding:10px 12px;margin-bottom:8px}
.game{display:grid;grid-template-columns:1fr auto;gap:2px 10px;align-items:center}
.teams{min-width:0}
.team{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.team.win{font-weight:650;color:var(--accent)}
.sc{font-variant-numeric:tabular-nums;font-weight:650;font-size:1.05rem;white-space:nowrap}
.when{color:var(--muted);font-size:.82rem;white-space:nowrap}
.meta{grid-column:1/-1;color:var(--muted);font-size:.78rem;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chip{display:inline-block;background:var(--chip);border-radius:99px;
  padding:1px 7px;font-size:.7rem;color:var(--muted);margin-right:6px}
.empty{color:var(--muted);font-size:.88rem;padding:6px 2px}
details{background:var(--card);border:1px solid var(--line);border-radius:10px;
  margin-bottom:8px;overflow:hidden}
summary{padding:11px 12px;cursor:pointer;font-weight:600;list-style:none}
summary::-webkit-details-marker{display:none}
summary::after{content:"▾";float:right;color:var(--muted)}
details[open] summary::after{content:"▴"}
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:.85rem}
th,td{padding:6px 8px;text-align:right;white-space:nowrap;border-top:1px solid var(--line)}
th{color:var(--muted);font-weight:600;font-size:.72rem;text-transform:uppercase}
td.tm,th.tm{text-align:left;white-space:normal;min-width:150px}
tbody tr:first-child td{border-top:1px solid var(--line)}
td.pts{font-weight:700}
footer{margin-top:32px;color:var(--muted);font-size:.76rem;text-align:center}
a{color:inherit}
</style>
</head>
<body>

<h1>Boys 13U — Scores &amp; Standings</h1>
<p class="sub">Utah Youth Soccer · 2026 Fall · updated {{ stamp .GeneratedAt }}</p>

{{ define "gamecard" }}
<div class="card game">
  <div class="teams">
    <span class="team{{ if winner . "home" }} win{{ end }}">{{ .Home }}</span>
    <span class="team{{ if winner . "away" }} win{{ end }}">{{ .Away }}</span>
  </div>
  <div style="text-align:right">
    {{ with score . }}<div class="sc">{{ . }}</div>
    {{ else }}<div class="when">{{ clock .Kickoff }}</div>{{ end }}
  </div>
  <div class="meta">
    <span class="chip">{{ .FlightName }}</span>{{ day .Kickoff }} · {{ .Venue }}{{ with .Field }} · Field {{ . }}{{ end }}
  </div>
</div>
{{ end }}

<h2>Today</h2>
{{ if .Today }}{{ range .Today }}{{ template "gamecard" . }}{{ end }}
{{ else }}<p class="empty">No games today.</p>{{ end }}

<h2>Recent results</h2>
{{ if .Recent }}{{ range .Recent }}{{ template "gamecard" . }}{{ end }}
{{ else }}<p class="empty">{{ if .SeasonSoon }}Season hasn’t started — first matches are Aug 22.{{ else }}Nothing in the last 7 days.{{ end }}</p>{{ end }}

<h2>Next 7 days</h2>
{{ if .Upcoming }}{{ range .Upcoming }}{{ template "gamecard" . }}{{ end }}
{{ else }}<p class="empty">Nothing scheduled in the next 7 days.</p>{{ end }}

<h2>Standings</h2>
{{ range .Flights }}
<details>
  <summary>{{ .Name }}</summary>
  <div class="scroll">
  <table>
    <thead><tr>
      <th class="tm">Team</th><th>W</th><th>L</th><th>T</th>
      <th>Pts</th><th>GD</th><th>GF</th><th>GA</th>
    </tr></thead>
    <tbody>
    {{ range .Standings }}
      <tr>
        <td class="tm">{{ .Team }}</td>
        <td>{{ .Wins }}</td><td>{{ .Losses }}</td><td>{{ .Ties }}</td>
        <td class="pts">{{ .TotalPoints }}</td>
        <td>{{ .GoalDiff }}</td><td>{{ .GoalsFor }}</td><td>{{ .GoalsAgainst }}</td>
      </tr>
    {{ end }}
    </tbody>
  </table>
  </div>
</details>
{{ end }}

<footer>
  Scraped from <a href="https://uysa.sportsaffinity.com/">uysa.sportsaffinity.com</a>.<br>
  Last updated {{ stamp .GeneratedAt }}.
</footer>

</body>
</html>
